with open('POSmoketestupdate.csv', 'r') as po_list:
    csv_reader = csv.reader(po_list)
    next(csv_reader)
    
    for line in csv_reader:
        print(type(line[0]))
        ponum = line[0]
        linenum = line[1]
        print(linenum)
        url = "https://diageo.coupahost.com/api/purchase_orders?filter=Pofilter&po-number="+ponum
        
        response = requests.request("GET", url, headers=headers, data=payload)
        print(response)
        datalist = json.loads(response.text)
#        print(linenum)
        data = datalist[0]
#        print('header data :')
 #       print(data['id'], data['ship-to-attention'])
        PONumber = data['po-number']
        POID = data['id']
        print(POID)
        print(PONumber)
              
        

        for line in data['order-lines']:
#            print(line['line-num'], line['description'], line['total'], line['account']['code'], line['account']['segment-2'])
            
            Line_Number=line['line-num']
            print(Line_Number)
            if(Line_Number==linenum):
                print(Line_Number)              
            
                Line_id=line['id']
                print(Line_id)
                #Need_By_Date2=line['need-by-date']
                line_data = [PONumber,Line_Number, POID, Line_id]
                print(line_data)
                            
                with open('updatev15cfeb.csv', 'a', newline='', encoding='utf-8') as f_object:  
                    # Pass the CSV  file object to the writer() function
                    writer_object = writer(f_object)
                    # Result - a writer object
                    # Pass the data in the list as an argument into the writerow() function
                    writer_object.writerow(line_data)  
                    # Close the file object
                    f_object.close()


            
            




